# ==================================================================
# CICADAS .gitignore
# ==================================================================

# --- MATLAB artifacts ---
*.asv
*.mex*
*.autosave
slprj/
octave-workspace
matlab_crash_dump.*

# --- OS / editor junk ---
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.ipynb_checkpoints/

# --- Python artifacts ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# --- Generated data and results ---
# Regenerate via run_all.m. Keep only small ground-truth parameter files.
*.mat
!parmsTrue.mat
!parmsTrue_*.mat

*.csv

# --- Generated figures and reports ---
# Authoritative manuscript figures live in the paper LaTeX repo, not here.
*.pdf
*.png
!docs/**/*.pdf
!docs/**/*.png

# --- Timestamped result text files ---
*_results_*.txt
*_summary.txt

# --- Local-only snapshots and backups ---
reproduction_baseline/
old/
outputs/

# --- Working docs (not for public repo) ---
"@-*.docx"
"@-*.pdf"
*.docx

# --- Python & markdown auxiliary ---
Python_And_Markdown/test_output.txt
