# ==================================================================
# CICADAS .gitignore
# ==================================================================

# --- MATLAB artifacts ---
*.asv
*.mex*
*.autosave
slprj/
octave-workspace
matlab_crash_dump.*

# --- OS / editor junk ---
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.ipynb_checkpoints/

# --- Python artifacts ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# --- Generated data and results ---
# Regenerate via run_all.m. Keep only small ground-truth parameter files.
*.mat
!parmsTrue.mat
!parmsTrue_*.mat

*.csv

# --- Generated figures and reports ---
# Authoritative manuscript figures live in the paper LaTeX repo, not here.
*.pdf
*.png
!docs/**/*.pdf
!docs/**/*.png

# --- Timestamped result text files ---
*_results_*.txt
*_summary.txt

# --- Local-only snapshots and backups ---
reproduction_baseline/
old/
outputs/
python.backup-*/

# --- Parity-verification reference outputs ---
# `matlab_outputs/` and `python_outputs/` are captured reference runs used by
# `verify_parity.py` and referenced in `PARITY_REPORT.md`. We ship them so
# reviewers can verify parity on clone without running the 4–8 h pipeline.
# Override the globs above for these dirs (but still ignore logs and the big
# regenerable trialData CSVs).
!matlab_outputs/**
!python_outputs/**
matlab_outputs/logs/
python_outputs/logs/
matlab_outputs/**/trialData*.csv
python_outputs/**/trialData*.csv

# --- Working docs (not for public repo) ---
"@-*.docx"
"@-*.pdf"
*.docx

# --- Python & markdown auxiliary ---
Python_And_Markdown/test_output.txt
wait_and_verify.log
wait_and_verify.sh

# Multi-seed replication results are cited by the manuscript; keep them
!multiseed/*.csv
